<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="64dp"
    android:paddingTop="32dp"
    android:paddingEnd="64dp"
    android:paddingBottom="32dp"
    tools:context=".activities.NetworkScanActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/discovery_title"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/scannerDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/discovery_ready"
        android:textSize="20sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ListView
        android:id="@+id/serverList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusDown="@id/startScanButton" />

    <Button
        android:id="@+id/startScanButton"
        style="@style/Widget.Leanback.DetailsActionButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:onClick="onClick"
        android:text="@string/discovery_start" />

    <Button
        android:id="@+id/manualSetupButton"
        style="@style/Widget.Leanback.DetailsActionButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:onClick="onClick"
        android:text="@string/discovery_manual_setup" />

</LinearLayout>
